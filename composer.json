{
    "name": "venusian-surface/drawing",
    "description": "Surface drawing: one rendering-engine API over CPU and GPU, the DrawingManager that builds engines, and VelvetGE, the software engine over Rasterize and a framebuffer.",
    "keywords": [
        "venusian",
        "surface",
        "drawing",
        "rendering",
        "software-renderer"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/surface/0.10.x/drawing",
    "support": {
        "issues": "https://github.com/VenusianPHP/surface/issues",
        "source": "https://github.com/venusian-surface/drawing"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/framebuffers": "^0.10.0",
        "venusian-surface/nuts-and-bolts": "^0.10.0",
        "venusian-surface/rasterize": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.1",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "suggest": {
        "jovian/venusian-metal": "The 'metal' rendering engine (macOS).",
        "jovian/venusian-opengl": "The 'opengl' rendering engine.",
        "jovian/venusian-sdl3": "The 'sdl3' rendering engine (SDL_GPU).",
        "jovian/venusian-vulkan": "The 'vulkan' rendering engine (MoltenVK on macOS)."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Surface\\Drawing\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Drawing\\DrawingServiceProvider"
            ]
        }
    }
}
